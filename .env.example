# Arena WebBridge — environment reference (copy to .env as needed; never commit .env)
# Core
ARENA_PORT=8989
PORT=8989
HOST=127.0.0.1
USER_DATA_DIR=~/.arena-webbridge/chrome-profile
ARENA_BASE_URL=https://arena.ai
HEADLESS=true

# Z.AI REST API (optional — enables glm-* direct routing, no browser)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_DEFAULT_MODEL=glm-5.3-flash

# Z.AI web-session (chat.z.ai scraping)
ZAI_WEB_ENABLED=
ZAI_WEB_BASE_URL=https://chat.z.ai
ZAI_WEB_USER_DATA_DIR=~/.arena-webbridge/zai-profile
ZAI_WEB_HEADLESS=false
ZAI_WEB_TIMEOUT_MS=180000
ZAI_WEB_CAPTCHA_WAIT_MS=180000

# Claude web-session (claude.ai)
CLAUDE_WEB_ENABLED=
CLAUDE_WEB_BASE_URL=https://claude.ai
CLAUDE_WEB_USER_DATA_DIR=~/.arena-webbridge/claude-profile
CLAUDE_WEB_HEADLESS=false
CLAUDE_WEB_TIMEOUT_MS=300000

# Tencent AI Studio (aistudio.tencent.ai)
TENCENT_AI_WEB_ENABLED=
TENCENT_AI_WEB_BASE_URL=https://aistudio.tencent.ai
TENCENT_AI_WEB_USER_DATA_DIR=~/.arena-webbridge/tencent-ai-profile
TENCENT_AI_WEB_HEADLESS=false
TENCENT_AI_WEB_TIMEOUT_MS=300000

# Gemini (gemini.google.com)
GEMINI_WEB_ENABLED=
GEMINI_WEB_BASE_URL=https://gemini.google.com
GEMINI_WEB_USER_DATA_DIR=~/.arena-webbridge/gemini-profile
GEMINI_WEB_HEADLESS=false
GEMINI_WEB_TIMEOUT_MS=300000

# Qwen (chat.qwen.ai)
QWEN_WEB_ENABLED=
QWEN_WEB_BASE_URL=https://chat.qwen.ai
QWEN_WEB_USER_DATA_DIR=~/.arena-webbridge/qwen-profile
QWEN_WEB_HEADLESS=false
QWEN_WEB_TIMEOUT_MS=300000

# Debug (opt-in screenshot capture)
ARENA_DEBUG=
