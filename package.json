{
  "name": "arena-web-api",
  "version": "0.1.0",
  "description": "OpenAI-compatible Web-to-API bridge for Arena (arena.ai)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "arena-web-api": "./dist/cli.js",
    "webbridge": "./dist/cli.js",
    "arena-webbridge": "./dist/cli.js",
    "EMO.ai": "./dist/emo-ai.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js dist/emo-ai.js 2>/dev/null || (tsc && chmod +x dist/cli.js)",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/cli.ts serve",
    "login": "tsx src/cli.ts login",
    "emo": "tsx src/emo-ai.ts"
  },
  "keywords": [
    "arena",
    "openai",
    "llm",
    "bridge",
    "fastify",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
