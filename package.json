{
  "name": "emo-ai-web",
  "version": "0.1.0",
  "description": "EMO-AI-web — OpenAI-compatible local web-to-API gateway and agent bridge",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "emo-ai-web": "./dist/cli.js",
    "arena-web-api": "./dist/cli.js",
    "webbridge": "./dist/cli.js",
    "arena-webbridge": "./dist/cli.js",
    "EMO.ai": "./dist/emo-ai.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js dist/emo-ai.js 2>/dev/null || (tsc && chmod +x dist/cli.js)",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/cli.ts serve",
    "login": "tsx src/cli.ts login",
    "emo": "tsx src/emo-ai.ts",
    "swarm": "tsx src/cli.ts swarm"
  },
  "keywords": [
    "arena",
    "openai",
    "llm",
    "bridge",
    "fastify",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
